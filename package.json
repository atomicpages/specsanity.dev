{
  "name": "specsanity",
  "version": "1.0.50",
  "private": true,
  "type": "module",
  "module": "src/worker/index.ts",
  "scripts": {
    "build": "bun build.ts",
    "cf-typegen": "wrangler types",
    "deploy": "bun run build && wrangler deploy",
    "dev": "bun --watch --hot src/index.ts",
    "dev:worker": "bun run build && wrangler dev",
    "format:md": "prettier --write --prose-wrap=always",
    "lint": "biome check . --diagnostic-level error",
    "test": "bun test --randomize",
    "typecheck": "tsc --noEmit --incremental",
    "prepare": "husky"
  },
  "overrides": {
    "dompurify": ">3.4.6"
  },
  "dependencies": {
    "@base-ui-components/react": "1.0.0-rc.0",
    "@base-ui/react": "1.6.0",
    "@elysia/openapi": "1.4.15",
    "@elysia/static": "1.4.11",
    "@elysiajs/eden": "1.4.9",
    "@monaco-editor/react": "4.7.0",
    "@redocly/openapi-core": "2.38.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dequal": "2.0.3",
    "elysia": "1.4.29",
    "envalid": "8.2.0",
    "jotai": "2.20.1",
    "lucide-react": "1.24.0",
    "nanoid": "6.0.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-resizable-panels": "4.12.1",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/bun": "latest",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "bun-plugin-tailwind": "0.1.2",
    "bun-types": "latest",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.5",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.110.0"
  }
}
